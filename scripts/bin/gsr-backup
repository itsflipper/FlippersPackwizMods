#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f "$0")"
REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd)"
ENVIRONMENTS_ROOT="$REPO_ROOT/environments"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
BACKUP_ROOT="$DATA_HOME/gsr/backups"
MARKER_ROOT="$STATE_HOME/gsr/backup-prepared"
RESTORE_SOURCE_STAGE=""
RESTORE_INCOMING_STAGE=""

cleanup_restore_staging() {
    [[ -z "$RESTORE_SOURCE_STAGE" ]] || rm -rf -- "$RESTORE_SOURCE_STAGE"
    [[ -z "$RESTORE_INCOMING_STAGE" ]] || rm -rf -- "$RESTORE_INCOMING_STAGE"
}

trap cleanup_restore_staging EXIT

# A command reached through sudo -u does not necessarily inherit the service
# user's runtime directory. Podman and future restore commands need it when
# the backup tool is called remotely.
setup_user_runtime() {
    local runtime
    runtime="/run/user/$(id -u)"
    if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "$runtime" ]]; then
        export XDG_RUNTIME_DIR="$runtime"
    fi
    if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "${XDG_RUNTIME_DIR:-}/bus" ]]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    fi
}

setup_user_runtime

usage() {
    cat <<'EOF'
Usage:
  gsr-backup prepare <environment>
  gsr-backup finalize <environment>
  gsr-backup create <environment>
  gsr-backup verify <environment>
  gsr-backup restore <environment> <new-volume>
  gsr-backup restore-server <environment>
  gsr-backup list

Transport helpers (used by gsr-backup-pull only):
  gsr-backup share-info <environment>
  gsr-backup share-bundle <environment>
  gsr-backup receive-restore <environment>

prepare and finalize are systemd stop hooks. create only exports an environment
whose container is already stopped. Each environment keeps one verified local
backup under ~/.local/share/gsr/backups/.
EOF
}

fail() {
    echo "gsr-backup: $*" >&2
    return 1
}

environment_file() {
    local environment="$1"
    local files=("$ENVIRONMENTS_ROOT/$environment"/*.container)

    [[ ${#files[@]} -eq 1 && -f "${files[0]}" ]] || return 1
    printf '%s\n' "${files[0]}"
}

load_environment() {
    local environment="$1" file

    file="$(environment_file "$environment")" || {
        fail "unknown or invalid environment: $environment"
        return 1
    }

    BACKUP_ENVIRONMENT="$environment"
    BACKUP_CONTAINER="$(sed -nE 's/^ContainerName=([^[:space:]#]+).*/\1/p' "$file" | head -n1)"
    BACKUP_VOLUME="$(sed -nE 's#^Volume=([^:[:space:]]+):/data(:[^[:space:]]*)?$#\1#p' "$file" | head -n1)"
    BACKUP_VERSION="$(sed -nE 's/^Environment=VERSION=([^[:space:]#]+).*/\1/p' "$file" | head -n1)"
    BACKUP_WORLD="$(sed -nE 's/^Environment=LEVEL=([^[:space:]#]+).*/\1/p' "$file" | head -n1)"
    BACKUP_SERVICE="$(basename "$file" .container)"

    [[ -n "$BACKUP_CONTAINER" && -n "$BACKUP_VOLUME" && -n "$BACKUP_VERSION" && -n "$BACKUP_WORLD" ]] || {
        fail "cannot determine container, /data volume, Minecraft version, or world for $environment"
        return 1
    }

    BACKUP_DIR="$BACKUP_ROOT/$BACKUP_ENVIRONMENT"
    SNAPSHOT_DIR="$BACKUP_DIR/snapshots"
    MARKER_FILE="$MARKER_ROOT/$BACKUP_ENVIRONMENT.prepared"
}

container_running() {
    podman inspect -f '{{.State.Running}}' "$BACKUP_CONTAINER" 2>/dev/null | grep -qx true
}

prepare() {
    load_environment "$1"
    mkdir -p "$MARKER_ROOT"
    chmod 700 "$MARKER_ROOT"
    rm -f "$MARKER_FILE"

    if ! container_running; then
        echo "gsr-backup: $BACKUP_ENVIRONMENT is not running; no stop backup prepared."
        return 0
    fi

    if ! podman exec "$BACKUP_CONTAINER" rcon-cli 'save-all flush'; then
        echo "gsr-backup: cannot flush $BACKUP_ENVIRONMENT; preserving the previous backup." >&2
        return 0
    fi

    umask 077
    printf '%s\n' "$(date --utc --iso-8601=seconds)" > "$MARKER_FILE"
    echo "gsr-backup: prepared clean backup of $BACKUP_ENVIRONMENT after stop."
}

write_manifest() {
    local target="$1" archive_name="$2" digest="$3" archive_size="$4" created_at="$5" commit

    commit="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || printf 'unknown')"
    python3 - "$target" "$BACKUP_ENVIRONMENT" "$BACKUP_VOLUME" "$BACKUP_VERSION" "$BACKUP_WORLD" \
        "$archive_name" "$digest" "$archive_size" "$created_at" "$commit" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
payload = {
    "schema_version": 1,
    "created_at": sys.argv[9],
    "environment": sys.argv[2],
    "volume": sys.argv[3],
    "minecraft_version": sys.argv[4],
    "world_directory": sys.argv[5],
    "archive": sys.argv[6],
    "sha256": sys.argv[7],
    "archive_bytes": int(sys.argv[8]),
    "repository_commit": sys.argv[10],
    "includes": [
        "complete Podman /data volume",
        "private shared identities and whitelist source",
    ],
}
path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
path.chmod(0o600)
PY
}

copy_shared_identity_source() {
    local destination="$1" config_home="${XDG_CONFIG_HOME:-$HOME/.config}" source
    local shared="$config_home/gsr/shared"

    mkdir -p "$destination"
    for source in identities.json whitelist.json; do
        if [[ -f "$shared/$source" ]]; then
            cp -p "$shared/$source" "$destination/$source"
            chmod 600 "$destination/$source"
        fi
    done
}

verify_snapshot() {
    local snapshot archive checksum

    snapshot="$1"
    archive="$snapshot/volume.tar.zst"
    checksum="$archive.sha256"

    [[ -f "$archive" && -f "$checksum" && -f "$snapshot/manifest.json" ]] || {
        fail "snapshot is incomplete: $snapshot"
        return 1
    }
    (
        cd "$snapshot"
        sha256sum --check --status "volume.tar.zst.sha256"
    )
    zstd -tq "$archive"
    zstd -dcq "$archive" | tar -tf - >/dev/null
    python3 -m json.tool "$snapshot/manifest.json" >/dev/null
}

verify_snapshot_environment() {
    local snapshot="$1" expected_environment="$2"

    verify_snapshot "$snapshot"
    python3 - "$snapshot/manifest.json" "$expected_environment" <<'PY'
import json
import sys

payload = json.load(open(sys.argv[1], encoding="utf-8"))
if payload.get("environment") != sys.argv[2]:
    raise SystemExit("backup environment does not match")
PY
}

remove_old_snapshots() {
    local current="$1" snapshot

    while IFS= read -r -d '' snapshot; do
        [[ "$snapshot" == "$current" ]] && continue
        rm -rf -- "$snapshot"
    done < <(find "$SNAPSHOT_DIR" -mindepth 1 -maxdepth 1 -type d -print0)
}

create_backup() {
    local allow_running="$1" created_at snapshot_id stage archive digest archive_size current_target

    command -v zstd >/dev/null || fail "zstd is required for backups."
    command -v tar >/dev/null || fail "tar is required for backups."
    podman volume exists "$BACKUP_VOLUME" || fail "Podman volume does not exist: $BACKUP_VOLUME"

    if [[ "$allow_running" == false ]] && container_running; then
        fail "$BACKUP_ENVIRONMENT is still running; stop it before using create."
    fi

    mkdir -p "$SNAPSHOT_DIR"
    chmod 700 "$BACKUP_ROOT" "$BACKUP_DIR" "$SNAPSHOT_DIR"
    umask 077
    created_at="$(date --utc --iso-8601=seconds)"
    snapshot_id="$(date --utc +%Y%m%dT%H%M%SZ)-$RANDOM$RANDOM"
    stage="$(mktemp -d "$SNAPSHOT_DIR/.staging.XXXXXX")"
    archive="$stage/volume.tar.zst"

    cleanup_stage() {
        rm -rf -- "$stage"
    }
    trap cleanup_stage RETURN

    echo "gsr-backup: exporting $BACKUP_VOLUME for $BACKUP_ENVIRONMENT ..."
    podman volume export "$BACKUP_VOLUME" | zstd -T0 -q -o "$archive"
    digest="$(sha256sum "$archive" | awk '{print $1}')"
    printf '%s  %s\n' "$digest" "volume.tar.zst" > "$archive.sha256"
    archive_size="$(stat -c %s "$archive")"
    copy_shared_identity_source "$stage/shared"
    write_manifest "$stage/manifest.json" "volume.tar.zst" "$digest" "$archive_size" "$created_at"
    verify_snapshot "$stage"

    current_target="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"
    mv "$stage" "$SNAPSHOT_DIR/$snapshot_id"
    stage="$SNAPSHOT_DIR/$snapshot_id"
    ln -s "snapshots/$snapshot_id" "$BACKUP_DIR/.current.new"
    mv -Tf "$BACKUP_DIR/.current.new" "$BACKUP_DIR/current"
    remove_old_snapshots "$stage"
    trap - RETURN

    echo "gsr-backup: verified backup of $BACKUP_ENVIRONMENT is now current."
    [[ -z "$current_target" ]] || echo "gsr-backup: replaced previous local backup."
}

finalize() {
    load_environment "$1"

    [[ -f "$MARKER_FILE" ]] || {
        echo "gsr-backup: no prepared stop for $BACKUP_ENVIRONMENT; previous backup kept."
        return 0
    }
    rm -f "$MARKER_FILE"

    if [[ "${SERVICE_RESULT:-success}" != success ]]; then
        echo "gsr-backup: $BACKUP_ENVIRONMENT stopped unsuccessfully; previous backup kept." >&2
        return 0
    fi
    if container_running; then
        echo "gsr-backup: $BACKUP_ENVIRONMENT still runs; previous backup kept." >&2
        return 0
    fi

    create_backup true
}

verify_current() {
    load_environment "$1"
    local current

    current="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"
    [[ -n "$current" && -d "$current" ]] || fail "no current backup for $BACKUP_ENVIRONMENT"
    verify_snapshot "$current"
    echo "gsr-backup: current backup for $BACKUP_ENVIRONMENT is valid."
}

current_snapshot() {
    local current

    current="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"
    [[ -n "$current" && -d "$current" ]] || fail "no current backup for $BACKUP_ENVIRONMENT"
    verify_snapshot "$current"
    printf '%s\n' "$current"
}

share_info() {
    local current

    load_environment "$1"
    current="$(current_snapshot)"
    cat "$current/manifest.json"
}

share_bundle() {
    local current

    load_environment "$1"
    current="$(current_snapshot)"
    # stdout is deliberately binary-only. This is consumed over SSH by the
    # local pull tool; diagnostics remain on stderr through fail()/tar.
    if [[ -d "$current/shared" ]]; then
        tar -C "$current" -cf - manifest.json volume.tar.zst volume.tar.zst.sha256 shared
    else
        tar -C "$current" -cf - manifest.json volume.tar.zst volume.tar.zst.sha256
    fi
}

restore_current() {
    local environment="$1" target_volume="$2" current

    load_environment "$environment"
    [[ "$target_volume" =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]] || {
        fail "invalid target volume name: $target_volume"
        return 1
    }
    [[ "$target_volume" != "$BACKUP_VOLUME" ]] || {
        fail "restore requires a new volume name, not the live volume: $BACKUP_VOLUME"
        return 1
    }
    if podman volume exists "$target_volume"; then
        fail "target volume already exists: $target_volume"
        return 1
    fi

    current="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"
    [[ -n "$current" && -d "$current" ]] || fail "no current backup for $BACKUP_ENVIRONMENT"
    verify_snapshot "$current"

    podman volume create "$target_volume" >/dev/null
    if ! zstd -dcq "$current/volume.tar.zst" | podman volume import "$target_volume" -; then
        fail "restore failed; the new volume was left in place for inspection: $target_volume"
        return 1
    fi
    echo "gsr-backup: restored $BACKUP_ENVIRONMENT into new volume $target_volume."
}

restore_live_from_snapshot() {
    local environment="$1" source="$2" protected_source="" pre_restore current_before current_after

    load_environment "$environment"
    verify_snapshot_environment "$source" "$environment"

    # The automatic stop hook rotates the one server-local snapshot. Protect a
    # source from that snapshot directory before stopping the service.
    if [[ "$source" == "$SNAPSHOT_DIR"/* ]]; then
        protected_source="$(mktemp -d "$BACKUP_DIR/.restore-source.XXXXXX")"
        cp -a "$source/." "$protected_source/"
        source="$protected_source"
    fi

    RESTORE_SOURCE_STAGE="$protected_source"
    current_before="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"

    if systemctl --user is-active --quiet "$BACKUP_SERVICE.service"; then
        echo "gsr-backup: stopping $BACKUP_ENVIRONMENT and creating a rollback backup ..."
        systemctl --user stop "$BACKUP_SERVICE.service"
    else
        # A stopped service bypasses the stop hook, so make the rollback backup
        # explicitly before modifying the named live volume.
        create_backup false
    fi
    if container_running; then
        fail "$BACKUP_ENVIRONMENT is still running after stop"
        return 1
    fi
    # Stop hooks intentionally keep the previous snapshot if their export
    # fails. A restore must never rely on that ambiguous result: if the hook
    # did not rotate current, create and verify the rollback backup ourselves.
    current_after="$(readlink -e "$BACKUP_DIR/current" 2>/dev/null || true)"
    if [[ -z "$current_after" || "$current_after" == "$current_before" ]]; then
        create_backup false
    fi
    pre_restore="$(current_snapshot)"

    echo "gsr-backup: replacing live volume $BACKUP_VOLUME from the verified backup ..."
    podman volume rm "$BACKUP_VOLUME"
    podman volume create "$BACKUP_VOLUME" >/dev/null
    if ! zstd -dcq "$source/volume.tar.zst" | podman volume import "$BACKUP_VOLUME" -; then
        echo "gsr-backup: restore import failed; attempting rollback volume recovery ..." >&2
        podman volume rm "$BACKUP_VOLUME" || true
        podman volume create "$BACKUP_VOLUME" >/dev/null
        if ! zstd -dcq "$pre_restore/volume.tar.zst" | podman volume import "$BACKUP_VOLUME" -; then
            fail "restore and automatic rollback both failed; service remains stopped"
            return 1
        fi
        fail "restore failed; the pre-restore volume was recovered and remains stopped"
        return 1
    fi

    systemctl --user start "$BACKUP_SERVICE.service"
    [[ -z "$protected_source" ]] || rm -rf -- "$protected_source"
    RESTORE_SOURCE_STAGE=""
    echo "gsr-backup: $BACKUP_ENVIRONMENT now runs from the restored volume."
    echo "gsr-backup: the current server backup is the pre-restore rollback point."
}

restore_server_current() {
    local environment="$1" current confirmation

    load_environment "$environment"
    current="$(current_snapshot)"
    echo "This replaces the live volume $BACKUP_VOLUME with the current local backup."
    echo "A fresh rollback backup of the live volume will be created first."
    read -rp "Type RESTORE-$environment to continue: " confirmation
    [[ "$confirmation" == "RESTORE-$environment" ]] || {
        echo "gsr-backup: restore cancelled."
        return 0
    }
    restore_live_from_snapshot "$environment" "$current"
}

receive_restore() {
    local environment="$1" stage

    load_environment "$environment"
    mkdir -p "$BACKUP_DIR"
    chmod 700 "$BACKUP_ROOT" "$BACKUP_DIR"
    stage="$(mktemp -d "$BACKUP_DIR/.incoming-restore.XXXXXX")"
    RESTORE_INCOMING_STAGE="$stage"

    # The client sends a tar containing exactly a verified snapshot's public
    # backup files. Extraction stays inside a private staging directory until
    # all integrity checks pass.
    tar -xf - -C "$stage" --no-same-owner --no-same-permissions
    verify_snapshot_environment "$stage" "$environment"
    restore_live_from_snapshot "$environment" "$stage"
    rm -rf -- "$stage"
    RESTORE_INCOMING_STAGE=""
    echo "gsr-backup: received and restored verified backup for $environment."
}

show_list() {
    local environment current

    for environment in "$ENVIRONMENTS_ROOT"/*; do
        [[ -d "$environment" ]] || continue
        environment="$(basename "$environment")"
        if ! load_environment "$environment" 2>/dev/null; then
            continue
        fi
        current="$(readlink "$BACKUP_DIR/current" 2>/dev/null || true)"
        printf '%-16s %s\n' "$environment" "${current:-no backup}"
    done
}

case "${1:-}" in
    prepare|finalize|create|verify)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        case "$1" in
            prepare) prepare "$2" ;;
            finalize) finalize "$2" ;;
            create)
                load_environment "$2"
                create_backup false
                ;;
            verify) verify_current "$2" ;;
        esac
        ;;
    restore)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        restore_current "$2" "$3"
        ;;
    restore-server)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        restore_server_current "$2"
        ;;
    list)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        show_list
        ;;
    share-info|share-bundle)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        case "$1" in
            share-info) share_info "$2" ;;
            share-bundle) share_bundle "$2" ;;
        esac
        ;;
    receive-restore)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        receive_restore "$2"
        ;;
    -h|--help|help|'')
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
