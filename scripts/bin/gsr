#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
REPO_ROOT="${GSR_REPO_ROOT:-$(cd "$SCRIPT_DIR/../.." && pwd)}"
export GSR_REPO_ROOT="$REPO_ROOT"

usage() {
    cat <<'EOF'
Usage:
  gsr status [environment]
  gsr start <environment>
  gsr stop
  gsr restart
  gsr switch <environment>
  gsr rcon
  gsr properties edit
  gsr resources status [--sample <seconds>]
  gsr resources recommend [environment]
  gsr whitelist <command> [arguments...]
  gsr identity audit <environment>
  gsr backup <command> [arguments...]

Examples:
  gsr status
  gsr start vanilla
  gsr switch skyblock
  gsr rcon
  gsr properties edit
  gsr resources status --sample 180
  gsr resources recommend vanilla
  gsr whitelist audit
  gsr identity audit vanilla
  gsr backup verify vanilla
EOF
}

environment_command() {
    exec "$REPO_ROOT/scripts/switch-environment.sh" "$@"
}

case "${1:-help}" in
    help|-h|--help)
        usage
        ;;
    status|list|ls|start|stop|restart|switch|rcon)
        environment_command "$@"
        ;;
    properties)
        shift
        exec "$SCRIPT_DIR/gsr-properties" "$@"
        ;;
    resources)
        shift
        exec "$SCRIPT_DIR/gsr-resources" "$@"
        ;;
    whitelist)
        shift
        exec "$SCRIPT_DIR/mc-whitelist" "$@"
        ;;
    identity)
        shift
        exec "$SCRIPT_DIR/gsr-identity" "$@"
        ;;
    backup)
        shift
        exec "$SCRIPT_DIR/gsr-backup" "$@"
        ;;
    # Compatibility only for explicit old documentation while the new command
    # is rolled out. These forms are not installed as separate PATH commands.
    environment|env)
        shift
        environment_command "$@"
        ;;
    *)
        echo "Unknown gsr command: $1" >&2
        usage >&2
        exit 2
        ;;
esac
